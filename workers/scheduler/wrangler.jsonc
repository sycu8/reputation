{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reputa-scheduler-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": { "ENVIRONMENT": "development" },
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [{ "binding": "CONFIG_KV", "id": "00000000000000000000000000000001" }],
  "queues": {
    "producers": [
      { "binding": "DISCOVERY_NORMAL", "queue": "reputa-discovery-normal-dev" },
      { "binding": "DISCOVERY_PRIORITY", "queue": "reputa-discovery-priority-dev" }
    ]
  }
}
