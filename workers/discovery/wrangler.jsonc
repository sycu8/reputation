{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reputa-discovery-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // Optional secrets (wrangler secret put): BRAVE_SEARCH_API_KEY, YOUTUBE_API_KEY, X_BEARER_TOKEN,
  // REDDIT_ACCESS_TOKEN, REDDIT_CLIENT_ID, REDDIT_CLIENT_SECRET
  // Optional plain vars: RSS_FEED_URLS, SITEMAP_URLS (comma-separated public HTTPS URLs)
  // Always-on free discovery in code: public news RSS (HN/Bing/Google News) + public Reddit search RSS.
  "vars": {
    "RSS_FEED_URLS": "https://feeds.bbci.co.uk/news/rss.xml,https://feeds.bbci.co.uk/news/technology/rss.xml,https://vnexpress.net/rss/tin-moi-nhat.rss,https://vnexpress.net/rss/kinh-doanh.rss,https://vnexpress.net/rss/so-hoa.rss,https://www.theguardian.com/world/rss,https://www.theguardian.com/technology/rss,https://techcrunch.com/feed/,https://www.bleepingcomputer.com/feed/,https://thanhnien.vn/rss/home.rss,https://tuoitre.vn/rss/tin-moi-nhat.rss,https://hnrss.org/frontpage,https://feeds.arstechnica.com/arstechnica/index,https://www.theverge.com/rss/index.xml,https://www.wired.com/feed/rss,https://blog.cloudflare.com/rss/,https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml,https://www.zdnet.com/news/rss.xml,https://www.securityweek.com/feed/,https://krebsonsecurity.com/feed/,https://www.darkreading.com/rss.xml,https://vietnamnet.vn/rss/cong-nghe.rss,https://cafef.vn/thi-truong.rss"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MONITOR_DO", "class_name": "MonitorDO", "script_name": "reputa-state-dev" }
    ]
  },
  "queues": {
    "consumers": [
      { "queue": "reputa-discovery-normal-dev", "max_batch_size": 20, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "reputa-discovery-dlq-dev" },
      { "queue": "reputa-discovery-priority-dev", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "reputa-discovery-dlq-dev" }
    ],
    "producers": [
      { "binding": "CRAWL_STATIC", "queue": "reputa-crawl-static-dev" },
      { "binding": "CRAWL_BROWSER", "queue": "reputa-crawl-browser-dev" }
    ]
  },
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "reputa_discovery_dev" }],
  "env": {
    "production": {
      "name": "reputa-discovery-production",
      "vars": {
        "RSS_FEED_URLS": "https://feeds.bbci.co.uk/news/rss.xml,https://feeds.bbci.co.uk/news/technology/rss.xml,https://vnexpress.net/rss/tin-moi-nhat.rss,https://vnexpress.net/rss/kinh-doanh.rss,https://vnexpress.net/rss/so-hoa.rss,https://www.theguardian.com/world/rss,https://www.theguardian.com/technology/rss,https://techcrunch.com/feed/,https://www.bleepingcomputer.com/feed/,https://thanhnien.vn/rss/home.rss,https://tuoitre.vn/rss/tin-moi-nhat.rss,https://hnrss.org/frontpage,https://feeds.arstechnica.com/arstechnica/index,https://www.theverge.com/rss/index.xml,https://www.wired.com/feed/rss,https://blog.cloudflare.com/rss/,https://rss.nytimes.com/services/xml/rss/nyt/Technology.xml,https://www.zdnet.com/news/rss.xml,https://www.securityweek.com/feed/,https://krebsonsecurity.com/feed/,https://www.darkreading.com/rss.xml,https://vietnamnet.vn/rss/cong-nghe.rss,https://cafef.vn/thi-truong.rss"
      },
      "durable_objects": {
        "bindings": [
          { "name": "MONITOR_DO", "class_name": "MonitorDO", "script_name": "reputa-state-production" }
        ]
      },
      "queues": {
        "consumers": [
          { "queue": "reputa-discovery-normal-production", "max_batch_size": 20, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "reputa-discovery-dlq-production" },
          { "queue": "reputa-discovery-priority-production", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "reputa-discovery-dlq-production" }
        ],
        "producers": [
          { "binding": "CRAWL_STATIC", "queue": "reputa-crawl-static-production" },
          { "binding": "CRAWL_BROWSER", "queue": "reputa-crawl-browser-production" }
        ]
      },
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "reputa_discovery_production" }]
    }
  }
}
