{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reputa-dashboard-dev",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": { "name": "reputa-dashboard-staging" },
    "production": { "name": "reputa-dashboard-production" }
  }
}
