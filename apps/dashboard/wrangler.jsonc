{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reputa-dashboard-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Ensure /app and /docs resolve to their index.html (landing stays at /).
    "html_handling": "force-trailing-slash",
    "run_worker_first": [
      "/",
      "/index.html",
      "/mcp",
      "/robots.txt",
      "/sitemap.xml",
      "/auth.md",
      "/openapi.json",
      "/.well-known/*"
    ]
  },
  "env": {
    "staging": {
      "name": "reputa-dashboard-staging"
    },
    "production": {
      "name": "reputa-dashboard-production"
    }
  }
}
