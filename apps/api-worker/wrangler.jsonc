{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reputa-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "vars": {
    "ENVIRONMENT": "development",
    "SESSION_COOKIE_NAME": "reputa_session",
    "ALLOWED_ORIGINS": "http://localhost:8788"
  },
  "durable_objects": {
    "bindings": [
      { "name": "USER_DIRECTORY", "class_name": "UserDirectoryDO", "script_name": "reputa-state-dev" },
      { "name": "TENANT_DIRECTORY", "class_name": "TenantDirectoryDO", "script_name": "reputa-state-dev" },
      { "name": "MONITOR_DO", "class_name": "MonitorDO", "script_name": "reputa-state-dev" },
      { "name": "SCHEDULER_SHARD", "class_name": "SchedulerShardDO", "script_name": "reputa-state-dev" }
    ]
  },
  "kv_namespaces": [
    { "binding": "CONFIG_KV", "id": "00000000000000000000000000000001" }
  ],
  "r2_buckets": [
    { "binding": "RAW_CONTENT", "bucket_name": "reputa-raw-content-dev" }
  ],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "reputa_api_dev" }
  ],
  "env": {
    "staging": {
      "name": "reputa-api-staging",
      "vars": { "ENVIRONMENT": "staging", "SESSION_COOKIE_NAME": "reputa_session", "ALLOWED_ORIGINS": "https://staging.example.com" },
      "durable_objects": {
        "bindings": [
          { "name": "USER_DIRECTORY", "class_name": "UserDirectoryDO", "script_name": "reputa-state-staging" },
          { "name": "TENANT_DIRECTORY", "class_name": "TenantDirectoryDO", "script_name": "reputa-state-staging" },
          { "name": "MONITOR_DO", "class_name": "MonitorDO", "script_name": "reputa-state-staging" },
          { "name": "SCHEDULER_SHARD", "class_name": "SchedulerShardDO", "script_name": "reputa-state-staging" }
        ]
      },
      "kv_namespaces": [{ "binding": "CONFIG_KV", "id": "00000000000000000000000000000011" }],
      "r2_buckets": [{ "binding": "RAW_CONTENT", "bucket_name": "reputa-raw-content-staging" }],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "reputa_api_staging" }]
    },
    "production": {
      "name": "reputa-api-production",
      "vars": { "ENVIRONMENT": "production", "SESSION_COOKIE_NAME": "reputa_session", "ALLOWED_ORIGINS": "https://reputation.orangecloud.vn" },
      "durable_objects": {
        "bindings": [
          { "name": "USER_DIRECTORY", "class_name": "UserDirectoryDO", "script_name": "reputa-state-production" },
          { "name": "TENANT_DIRECTORY", "class_name": "TenantDirectoryDO", "script_name": "reputa-state-production" },
          { "name": "MONITOR_DO", "class_name": "MonitorDO", "script_name": "reputa-state-production" },
          { "name": "SCHEDULER_SHARD", "class_name": "SchedulerShardDO", "script_name": "reputa-state-production" }
        ]
      },
      "kv_namespaces": [{ "binding": "CONFIG_KV", "id": "00000000000000000000000000000021" }],
      "r2_buckets": [{ "binding": "RAW_CONTENT", "bucket_name": "reputa-raw-content-production" }],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "reputa_api_production" }]
    }
  }
}
